{
  "name": "hashfox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "description": "HashFox — unified paper-trading platform bundling PolyMock (Polymarket), Blockberg (crypto), and MockRock (traditional markets).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HashFoxLabs/HashFox-app.git"
  },
  "scripts": {
    "install": "npm run install:frontend",
    "install:frontend": "pnpm --dir frontend install",
    "dev": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "preview": "pnpm --dir frontend preview",
    "check": "pnpm --dir frontend check",

    "anchor:build": "cd contracts && anchor build",
    "anchor:test": "cd contracts && anchor test",
    "anchor:deploy": "cd contracts && anchor deploy",

    "clean": "rm -rf frontend/node_modules frontend/.svelte-kit frontend/build frontend/dist contracts/target"
  }
}

{
	"name": "hashfox-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"pages:deploy": "npm run build && npx wrangler pages deploy .svelte-kit/cloudflare",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vite-plugin-node-polyfills": "^0.24.0"
	},
	"dependencies": {
		"@coral-xyz/anchor": "^0.32.1",
		"@ledgerhq/errors": "6.26.0",
		"@magicblock-labs/bolt-sdk": "^0.2.4",
		"@pythnetwork/hermes-client": "2.1.0",
		"@solana/wallet-adapter-base": "^0.9.27",
		"@solana/wallet-adapter-wallets": "^0.19.37",
		"@solana/web3.js": "^1.98.4",
		"@stream-io/video-client": "^1.47.0",
		"@supabase/supabase-js": "^2.45.0",
		"@web3auth/base": "^9.7.0",
		"@web3auth/modal": "^9.7.0",
		"@web3auth/solana-provider": "^9.7.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"axios": "^1.12.2",
		"bn.js": "^5.2.1",
		"bs58": "^5.0.0",
		"lightweight-charts": "^5.1.0",
		"stream-chat": "^9.41.1"
	},
	"overrides": {
		"@ledgerhq/errors": "6.26.0"
	}
}

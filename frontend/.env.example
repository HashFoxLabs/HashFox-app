## Private (server-only — API routes)
SYNTHESIS_API_KEY=
BACKTEST_ENGINE_URL=
NEWDATA_API_KEY=

# Alpaca (US equities orderbook + trade tape, free IEX feed).
# Free keys at https://alpaca.markets — paper account credentials work for
# market data. If unset, the stocks orderbook falls back to the synthetic book.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# GetStream Chat — public key on client, secret server-only
PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

STRUCT_API_KEY=

# --- Cloudflare (Workers Git integration — matches dashboard: build + wrangler deploy) ---
# Root directory: `frontend`. Build: `npm run build`. Deploy: `npx wrangler deploy`.
# `wrangler.toml` uses `main` + `[assets]` (see repo). Project name in dashboard should match `name`
# in wrangler.toml (e.g. hashfox-app). Add the same server env vars under Variables and secrets.
#
# --- Cloudflare Pages (alternative — no wrangler deploy) ---
# Root `frontend`, build `npm run build`, build output directory `.svelte-kit/cloudflare` only.
# In Pages → Settings → Runtime, add compatibility flag `nodejs_als` if the dashboard prompts for it.
#
# Lockfile: Cloudflare runs `npm ci` when `package-lock.json` exists — it must match `package.json`.
# On mismatch errors, run `npm install` in `frontend/`, commit `package-lock.json`, push. Or set
# SKIP_DEPENDENCY_INSTALL=true and build command `npm install && npm run build`.
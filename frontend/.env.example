## HashFox unified app
## Public (client-side) env vars — prefix PUBLIC_

# Solana / program
PUBLIC_HASHFOX_PROGRAM_ID=7ApsvRSqfqCA5YbSSvAmeboFFU7hyB2HJBCpEiwmLSSi
PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
PUBLIC_MAGICBLOCK_RPC=https://rpc.magicblock.app/devnet/

# Pyth Hermes (optional API key)
PUBLIC_HERMES_URL=https://hermes.pyth.network
PUBLIC_PYTH_API_KEY=

# Supabase (optional — used for social/trade feed features)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

## Private (server-only — API routes)
SYNTHESIS_API_KEY=
BACKTEST_ENGINE_URL=
NEWDATA_API_KEY=

# Alpaca (US equities orderbook + trade tape, free IEX feed).
# Free keys at https://alpaca.markets — paper account credentials work for
# market data. If unset, the stocks orderbook falls back to the synthetic book.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# GetStream Chat — public key on client, secret server-only
PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

STRUCT_API_KEY=

# --- Cloudflare Pages ---
# In the Pages project: Settings → Environment variables, add the same names as above
# for Production / Preview (server vars are available to SvelteKit endpoints on the Worker).
# Build: root directory `frontend`, build command `npm run build`, output `.svelte-kit/cloudflare`, Node 20+.
#
# Lockfile: Pages runs `npm ci` when `package-lock.json` is present — it must match `package.json`
# exactly (same dependency names/versions). If deploy fails with "specifiers in the lockfile ...
# don't match specs in package.json", run `npm install` inside `frontend/`, commit the updated
# `package-lock.json` with `package.json`, push, and redeploy.
#
# Workaround without committing a new lockfile (less reproducible): set env SKIP_DEPENDENCY_INSTALL=true
# and build command `npm install && npm run build` so install uses `npm install` instead of `npm ci`.
# ──────────────────────────────────────────────────
# Dependencies
# ──────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnpm-store/

# Lockfiles — keep root, ignore per-app churn generated by CI installs
# (comment these out if you want to commit every lockfile)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ──────────────────────────────────────────────────
# Environment variables — never commit secrets
# ──────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.*.local
!.env.example
!**/.env.example

# ──────────────────────────────────────────────────
# Build outputs
# ──────────────────────────────────────────────────
build/
dist/
out/
.output/
.next/
.nuxt/
.cache/
.parcel-cache/
storybook-static/

# ──────────────────────────────────────────────────
# SvelteKit / Vite
# ──────────────────────────────────────────────────
.svelte-kit/
**/.svelte-kit/
.vite/
**/.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ──────────────────────────────────────────────────
# Rust / Cargo / Anchor / Solana
# ──────────────────────────────────────────────────
target/
**/target/
**/*.rs.bk
.cargo/
.anchor/
**/.anchor/
test-ledger/
**/test-ledger/
**/.bolt/

# Keypairs — NEVER commit private keys
*.pem
*-keypair.json
**/*-keypair.json
target/deploy/*.json

# ──────────────────────────────────────────────────
# Deploy tooling
# ──────────────────────────────────────────────────
.vercel
.wrangler/
**/.wrangler/
.turbo
.fly/

# ──────────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ──────────────────────────────────────────────────
# OS files
# ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────────
# IDE & editors
# ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ──────────────────────────────────────────────────
# Testing & coverage
# ──────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
playwright-report/
test-results/
**/.playwright/

# ──────────────────────────────────────────────────
# Databases
# ──────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3

# ──────────────────────────────────────────────────
# Temporary / misc
# ──────────────────────────────────────────────────
*.tmp
*.temp
.tmp/
.temp/
*.tsbuildinfo
.eslintcache

# ──────────────────────────────────────────────────
# Python (polymock scripts)
# ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ──────────────────────────────────────────────────
# App-specific
# ──────────────────────────────────────────────────
# polymock backtest engine fetched data
apps/polymock/backtest_engine_rs/data/
apps/polymock/backtest_engine/data/

# =========================================================
# Supabase (optional; features depending on it will be disabled without keys)
# =========================================================
# Get these from: Supabase project → Settings → API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# =========================================================
# Solana / MagicBlock RPC
# =========================================================
# Default devnet RPC used for balances + airdrops.
PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# MagicBlock devnet RPC used for fast session trading (optional).
PUBLIC_MAGICBLOCK_RPC=https://rpc.magicblock.app/devnet/
# =========================================================
# Pyth (Hermes streaming)
# =========================================================
PUBLIC_HERMES_URL=https://hermes.pyth.network
# Optional bearer token for Hermes (leave blank if not needed)
PUBLIC_PYTH_API_KEY=
# =========================================================
# On-chain program ID (Anchor)
# =========================================================
# Should match `contracts/Anchor.toml` (programs.devnet.hashfox)
PUBLIC_HASHFOX_PROGRAM_ID=7ApsvRSqfqCA5YbSSvAmeboFFU7hyB2HJBCpEiwmLSSi
# =========================================================
# Web3Auth (optional; enables embedded social login)
# =========================================================
PUBLIC_WEB3AUTH_CLIENT_ID=
# Legacy/compat (some local envs still use this name; frontend code uses PUBLIC_WEB3AUTH_CLIENT_ID)
VITE_WEB3AUTH_CLIENT_ID=
# =========================================================
# News (optional)
# =========================================================
NEWDATA_API_KEY=
# =========================================================
# Synthesis (optional)
# =========================================================
SYNTHESIS_API_KEY=
BACKTEST_ENGINE_URL=
# =========================================================
# Struct (optional; enables real-time market alerts)
# =========================================================
STRUCT_API_KEY=
# =========================================================
# Stream Chat (optional; enables live chat)
# =========================================================
PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=